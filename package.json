{
  "name": "css-a11y-checker",
  "publisher": "orange-business",
  "displayName": "CSS Accessibility Checker",
  "description": "Real-time accessibility detection using axe-core, ESLint jsx-a11y, and TypeScript rules",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cssA11y.runNow",
        "title": "Run A11y Analysis Now"
      },
      {
        "command": "cssA11y.fixWithAI",
        "title": "Corriger avec IA"
      },
      {
        "command": "cssA11y.fixWithAIFromHover",
        "title": "Corriger avec IA (hover)"
      },
      {
        "command": "cssA11y.showIssueDetail",
        "title": "Voir détails accessibilité"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "a11y-explorer",
          "title": "Accessibilité",
          "icon": "$(eye)"
        }
      ]
    },
    "views": {
      "a11y-explorer": [
        {
          "type": "webview",
          "id": "cssA11y.panel",
          "name": "Violations A11y"
        }
      ]
    },
    "configuration": {
      "title": "CSS A11y Checker",
      "properties": {
        "cssA11y.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "Debounce delay in ms before running analysis"
        },
        "cssA11y.enabledRules": {
          "type": "array",
          "default": [
            "color-contrast",
            "color-contrast-enhanced",
            "link-in-text-block"
          ],
          "description": "axe-core rules to enable"
        },
        "cssA11y.wcagLevel": {
          "type": "string",
          "enum": [
            "wcag2a",
            "wcag2aa",
            "wcag2aaa",
            "wcag21aa"
          ],
          "default": "wcag2aa",
          "description": "WCAG conformance level to enforce"
        },
        "cssA11y.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "ollama"
          ],
          "default": "ollama",
          "description": "AI provider for fix suggestions"
        },
        "cssA11y.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenAI or Anthropic"
        },
        "cssA11y.ai.model": {
          "type": "string",
          "default": "codellama",
          "description": "Model name to use"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.7",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "axe-core": "^4.11.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^24.1.3",
    "langchain": "^1.4.4",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
